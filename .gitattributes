# Line endings: normalized to LF in the repository, CRLF on checkout under Windows.
# Makes the repository independent of each workstation's core.autocrlf setting.
* text=auto

*.cs      text diff=csharp eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.slnx    text eol=crlf
*.razor   text eol=crlf
*.json    text eol=crlf
*.md      text eol=crlf
*.ps1     text eol=crlf
*.sql     text eol=crlf
*.sh      text eol=lf
Doxyfile  text eol=crlf

*.png  binary
*.jpg  binary
*.ico  binary
*.dll  binary
