<?xml version="1.0" encoding="utf-8"?>
<!--
  ┌──────────────┬──────────────────────────────────────────────────────────────┐
  │ File         │ test/CodeCoverage.config                                     │
  │ Scope        │ Code coverage collected by the CI (coverage option of the    │
  │              │ dotnet test command; see .github/workflows/ci.yml)           │
  │ Purpose      │ Measures the production code only: the test projects are     │
  │              │ already left out by default, and the TestKit library, test   │
  │              │ tooling too, is left out here.                               │
  │ Format       │ https://learn.microsoft.com/dotnet/core/additional-tools/    │
  │              │ dotnet-coverage#settings                                     │
  └──────────────┴──────────────────────────────────────────────────────────────┘
-->
<Configuration>
  <CodeCoverage>
    <!-- Each entry is a regular expression on the assembly file path -->
    <ModulePaths>
      <Exclude>
        <ModulePath>.*[\\/]BoardGamesPlatform\.TestKit\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
