<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Website, server part of the Blazor Auto application (hosted on IIS) -->

  <!-- Navigation from a static page completes without the exception used by older Blazor versions -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Projects -->
  <ItemGroup>
    <ProjectReference Include="..\BoardGamesPlatform.Observability\BoardGamesPlatform.Observability.csproj" />
    <ProjectReference Include="..\BoardGamesPlatform.Web.Client\BoardGamesPlatform.Web.Client.csproj" />
  </ItemGroup>

  <!-- Packages (versions in Directory.Packages.props) -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

</Project>
