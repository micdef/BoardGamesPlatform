@*
 *	@file	src/BoardGamesPlatform.Web/Components/Pages/Error.razor
 *	@author	Defraene Michaël (AKA Sonic) (co-written by Claude)
 *
 *	@brief	Generic error page
 *@

@page "/Error"
@using System.Diagnostics

@inject IStringLocalizer<WebTexts> Texts

<PageTitle>@Texts["Error_Title"]</PageTitle>

<h1 class="text-danger">@Texts["Error_Heading"]</h1>
<h2 class="text-danger">@Texts["Error_Message"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Texts["Error_RequestId"]</strong> <code>@RequestId</code>
    </p>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
