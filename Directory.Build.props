<Project>
  <!--
    ┌──────────────┬──────────────────────────────────────────────────────────────┐
    │ File         │ Directory.Build.props                                        │
    │ Scope        │ Every project below this folder (imported automatically)     │
    │ Purpose      │ Shared build baseline: framework, language, code quality.    │
    │              │ A project overrides a property only for a documented reason. │
    └──────────────┴──────────────────────────────────────────────────────────────┘
  -->

  <!-- Target and language -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Solution identity -->
  <PropertyGroup>
    <Authors>Michaël Defraene</Authors>
    <Product>SocialGamesPlatform</Product>
    <Copyright>© Michaël Defraene</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Quality: .NET analyzers and .editorconfig style are enforced at build time, not only in the IDE -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- XML documentation is mandatory: it feeds IntelliSense and Doxygen, and a missing comment (CS1591) breaks the build.
         Also required for IDE0005 (unnecessary usings) to be reported at build time. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Reproducible builds -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
