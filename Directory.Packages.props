<Project>
  <!--
    ┌──────────────┬──────────────────────────────────────────────────────────────┐
    │ File         │ Directory.Packages.props                                     │
    │ Scope        │ Every project of the solution                                │
    │ Purpose      │ Central Package Management (CPM): one version per package    │
    │              │ for the whole solution. Projects reference packages WITHOUT  │
    │              │ a version.                                                   │
    └──────────────┴──────────────────────────────────────────────────────────────┘
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A vulnerable transitive dependency can be pinned here without becoming a direct reference -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Analyzers applied to every project, with no reference in the .csproj files -->
  <ItemGroup>
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
  </ItemGroup>

  <!-- Hosting: Back and Very Back worker services -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <!-- Observability: system logs of the machine, OpenTelemetry logs, traces and metrics -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.14" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <!-- Tests: xUnit v3 on Microsoft.Testing.Platform, Test Explorer adapter, assertions, coverage and TRX extensions,
       architecture rules, fake time -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <!-- Blazor: website (server and WebAssembly parts) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
  </ItemGroup>
</Project>
